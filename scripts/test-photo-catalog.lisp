(require :asdf)
(push :photo-catalog-test *features*)
(load (merge-pathnames "photo-catalog.lisp" *load-truename*))
(let* ((root (uiop:ensure-directory-pathname (uiop:run-program '("mktemp" "-d" "/tmp/hrmc-photos-XXXXXX") :output '(:string :stripped t))))
       (*photo-root* root))
  (unwind-protect
    (progn
      (dolist (name '("image/photos/旅/a b.JPG" "image/photos/z.png" "image/photos/.hidden/h.jpg" "image/photos/no.txt" "photos/data.json" "index.html"))
        (let ((file (merge-pathnames name root)))
          (ensure-directories-exist file)
          (with-open-file (out file :direction :output) (write-string "test" out))))
      (with-open-file (out (merge-pathnames "photos/data.json" root) :direction :output :if-exists :supersede :external-format :utf-8)
        (write-string "[{\"src\":\"/image/photos/旅/a b.JPG\",\"alt\":\"説明\",\"caption\":\"旅\",\"extra\":true}]" out))
      (uiop:run-program (list "ln" "-s" "/etc/hosts" (namestring (merge-pathnames "image/photos/out.jpg" root))))
      (uiop:run-program (list "ln" "-s" (namestring (merge-pathnames "image/photos/" root))
                             (namestring (merge-pathnames "image/photos/loop" root))))
      (let* ((photos (photo-catalog root)) (entry (aref photos 1)))
        (assert (= 2 (length photos)))
        (assert (equal (gethash "src" entry) "/image/photos/%E6%97%85/a%20b.JPG"))
        (assert (equal (gethash "alt" entry) "説明"))
        (assert (equal (gethash "caption" entry) "旅"))
        (assert (search "true" (json-text photos))))
      (assert (probe-file (local-file "/")))
      (dolist (bad '("/../etc/hosts" "/%2e%2e/etc/hosts" "/.git/config" "/image/photos/out.jpg"))
        (assert (null (local-file bad))))
      (delete-file (merge-pathnames "image/photos/z.png" root))
      (assert (= 1 (length (photo-catalog root)))))
    (uiop:delete-directory-tree root :validate t)))
(format t "PASS: photo discovery, UTF-8 URLs, metadata, hidden files, symlinks, removal, static paths~%")

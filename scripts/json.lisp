;;; Shared JSON utilities. Loading this file does not generate site files.
(defun read-json (text)
  "Read JSON without invoking the Lisp reader on input data."
  (let ((i 0) (size (length text)))
    (labels ((peek () (when (< i size) (char text i)))
             (take () (or (prog1 (peek) (incf i)) (error "Unexpected JSON EOF")))
             (ws () (loop while (and (peek) (find (peek) '(#\Space #\Tab #\Return #\Newline))) do (incf i)))
             (expect (c) (unless (eql (take) c) (error "Expected \"~A\" at ~D" c i)))
             (hex4 () (let ((start i)) (incf i 4) (parse-integer text :start start :end i :radix 16)))
             (jstring ()
               (expect #\")
               (with-output-to-string (out)
                 (loop for c = (take) until (char= c #\") do
                   (cond
                     ((char= c #\\)
                      (write-char
                       (case (take)
                         (#\" #\") (#\\ #\\) (#\/ #\/)
                         (#\b #\Backspace) (#\f #\Page) (#\n #\Newline)
                         (#\r #\Return) (#\t #\Tab)
                         (#\u (let ((code (hex4)))
                                 (when (<= #xd800 code #xdbff)
                                   (expect #\\) (expect #\u)
                                   (let ((low (hex4)))
                                     (unless (<= #xdc00 low #xdfff) (error "Invalid surrogate"))
                                     (setf code (+ #x10000 (ash (- code #xd800) 10) (- low #xdc00)))))
                                 (when (<= #xd800 code #xdfff) (error "Invalid surrogate"))
                                 (or (code-char code) (error "Invalid Unicode"))))
                         (otherwise (error "Invalid JSON escape"))) out))
                     ((< (char-code c) 32) (error "Control character in JSON string"))
                     (t (write-char c out))))))
             (sequence-values (end)
               (ws)
               (if (eql (peek) end) (progn (take) nil)
                   (loop collect (value) into values do (ws)
                         when (eql (peek) end) do (take) and return values
                         do (expect #\,))))
             (literal (word result)
               (loop for c across word do (expect c)) result)
             (number-value ()
               ;; Unused numeric content is represented as a tagged literal.
               (let ((start i))
                 (when (eql (peek) #\-) (take))
                 (if (eql (peek) #\0) (take)
                     (progn
                       (unless (and (peek) (digit-char-p (peek))) (error "Invalid number"))
                       (loop while (and (peek) (digit-char-p (peek))) do (take))))
                 (when (eql (peek) #\.)
                   (take)
                   (unless (and (peek) (digit-char-p (peek))) (error "Invalid fraction"))
                   (loop while (and (peek) (digit-char-p (peek))) do (take)))
                 (when (and (peek) (find (peek) "eE"))
                   (take)
                   (when (and (peek) (find (peek) "+-")) (take))
                   (unless (and (peek) (digit-char-p (peek))) (error "Invalid exponent"))
                   (loop while (and (peek) (digit-char-p (peek))) do (take)))
                 (list :number (subseq text start i))))
             (value ()
               (ws)
               (case (peek)
                 (#\" (jstring))
                 (#\{ (take)
                       (let ((obj (make-hash-table :test 'equal)))
                         (ws)
                         (unless (eql (peek) #\})
                           (loop (ws)
                                 (let ((key (jstring)))
                                   (ws) (expect #\:) (setf (gethash key obj) (value)))
                                 (ws)
                                 (when (eql (peek) #\}) (return))
                                 (expect #\,)))
                         (expect #\}) obj))
                 (#\[ (take) (coerce (sequence-values #\]) 'vector))
                 (#\t (literal "true" :true))
                 (#\f (literal "false" :false))
                 (#\n (literal "null" :null))
                 (otherwise (number-value)))))
      (prog1 (value) (ws) (unless (= i size) (error "Trailing JSON input"))))))

(defun object (&rest pairs)
  (let ((obj (make-hash-table :test 'equal)))
    (loop for (key value) on pairs by #'cddr do (setf (gethash key obj) value)) obj))
(defun json-text (value)
  (with-output-to-string (out)
    (labels ((emit (v)
               (typecase v
                 (string (write-char #\" out)
                         (loop for c across v do
                           (case c
                             (#\" (write-string "\\\"" out))
                             (#\\ (write-string "\\\\" out))
                             (#\< (write-string "\\u003c" out))
                             (otherwise (if (< (char-code c) 32)
                                            (format out "\\u~4,'0X" (char-code c))
                                            (write-char c out)))))
                         (write-char #\" out))
                 (hash-table (write-char #\{ out)
                             (let ((first t))
                               (maphash (lambda (k val)
                                          (unless first (write-char #\, out))
                                          (setf first nil) (emit k) (write-char #\: out) (emit val)) v))
                             (write-char #\} out))
                 (symbol (write-string (ecase v (:true "true") (:false "false") (:null "null")) out))
                 (cons (if (and (eq (first v) :number) (stringp (second v))
                                 (equal v (read-json (second v))))
                            (write-string (second v) out)
                            (error "Invalid JSON number")))
                 (vector (write-char #\[ out)
                         (loop for item across v for i from 0 do
                           (unless (zerop i) (write-char #\, out)) (emit item))
                         (write-char #\] out))
                 (otherwise (error "Unsupported JSON output: \"~A\"" v)))))
      (emit value))))

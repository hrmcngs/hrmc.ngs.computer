(require :asdf)
(push :stars-test *features*)
(load (merge-pathnames "gen-stars.lisp" *load-truename*))
(assert (equal (star-url "https://www.github.com/a/b.git/issues?q=1") "https://github.com/a/b"))
(assert (equal (star-url "https://curseforge.com/minecraft/mc-mods/test/") "https://curseforge.com/minecraft/mc-mods/test"))
(assert (null (star-url "https://github.com/a")))
(assert (null (star-url "https://example.com/a/b")))
(let* ((content (read-json "{\"works\":[{\"url\":\"https://github.com/a/b\"}],\"stats\":[{\"links\":[\"https://www.github.com/a/b/\"]}]}")))
  (assert (equal (collect-star-urls content) '("https://github.com/a/b"))))
(let* ((old (read-json "{\"a\":{\"count\":9},\"b\":{\"count\":3}}"))
       (live (read-json "{\"a\":{\"count\":0},\"b\":{\"count\":null}}"))
       (merged (merge-star-entries '("a" "b" "c") live old)))
  (assert (equal (gethash "count" (gethash "a" merged)) '(:number "0")))
  (assert (equal (gethash "count" (gethash "b" merged)) '(:number "3")))
  (assert (not (gethash "c" merged)))
  (assert (equal (json-text merged) "{\"a\":{\"count\":0},\"b\":{\"count\":3}}")))
(format t "Star aggregation tests passed.~%")

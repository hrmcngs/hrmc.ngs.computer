;;; SBCL photo catalog and local HTTP server; no third-party libraries.
(require :asdf)
(require :sb-bsd-sockets)
(load (merge-pathnames "json.lisp" *load-truename*))
(defparameter *photo-root* (uiop:pathname-parent-directory-pathname
                           (uiop:pathname-directory-pathname *load-truename*)))

(defun url-encode-path (text)
  (with-output-to-string (out)
    (loop for byte across (sb-ext:string-to-octets text :external-format :utf-8) do
      (if (or (<= 65 byte 90) (<= 97 byte 122) (<= 48 byte 57) (find byte '(45 46 95 126 47)))
          (write-char (code-char byte) out)
          (format out "%~2,'0X" byte)))))

(defun within-directory-p (path directory)
  (uiop:subpathp (truename path) (truename directory)))

(defun photo-catalog (&optional (root *photo-root*))
  (let* ((directory (merge-pathnames "image/photos/" root))
         (data (merge-pathnames "photos/data.json" root))
         (previous (if (probe-file data) (read-json (uiop:read-file-string data)) #()))
         (metadata (make-hash-table :test 'equal)) (files nil) (visited (make-hash-table :test 'equal)))
    (map nil (lambda (item)
               (when (and (hash-table-p item) (stringp (gethash "src" item)))
                 (setf (gethash (gethash "src" item) metadata) item))) previous)
    (labels ((visible-p (path)
               (not (some (lambda (part) (and (plusp (length part)) (char= #\. (char part 0))))
                          (uiop:split-string (enough-namestring path root) :separator "/"))))
             (scan (dir)
               (when (and (visible-p dir) (within-directory-p dir directory)
                          (not (gethash (namestring (truename dir)) visited)))
                 (setf (gethash (namestring (truename dir)) visited) t)
                 ;; Keep lexical names for URLs, including symlinks that stay inside the photo tree.
                 (dolist (file (directory (merge-pathnames #P"*.*" dir) :resolve-symlinks nil))
                   (when (and (not (uiop:directory-pathname-p file)) (visible-p file)
                              (member (pathname-type file) '("jpg" "jpeg" "png" "webp" "avif" "gif") :test #'equalp)
                              (within-directory-p file directory))
                     (push file files)))
                 (dolist (sub (uiop:subdirectories dir)) (scan sub)))))
      (when (probe-file directory) (scan directory)))
    (coerce
      (loop for file in (sort files #'string< :key #'namestring) for i from 1
            for raw = (concatenate 'string "/" (enough-namestring file root))
            for src = (url-encode-path raw)
            for old = (or (gethash src metadata) (gethash raw metadata))
            for entry = (if old (copy-photo-metadata old) (make-hash-table :test 'equal))
            do (setf (gethash "src" entry) src)
               (unless (nth-value 1 (gethash "alt" entry))
                 (setf (gethash "alt" entry) (format nil "写真 ~D" i)))
            collect entry) 'vector)))

(defun copy-photo-metadata (table)
  (let ((copy (make-hash-table :test 'equal)))
    (maphash (lambda (key value) (setf (gethash key copy) value)) table) copy))

(defun write-photo-catalog ()
  (let ((photos (photo-catalog)))
    (with-open-file (out (merge-pathnames "photos/data.json" *photo-root*)
                         :direction :output :if-exists :supersede :external-format :utf-8)
      (write-line (json-text photos) out))
    (format t "Photo catalog: ~D images~%" (length photos))))

(defun decode-url-path (text)
  (let ((bytes (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
    (loop for i from 0 below (length text) for c = (char text i) do
      (if (char= c #\%)
          (progn
            (unless (< (+ i 2) (length text)) (error "Invalid URL escape"))
            (let ((hi (digit-char-p (char text (1+ i)) 16))
                  (lo (digit-char-p (char text (+ i 2)) 16)))
              (unless (and hi lo) (error "Invalid URL escape"))
              (vector-push-extend (+ (* hi 16) lo) bytes))
            (incf i 2))
          (loop for b across (sb-ext:string-to-octets (string c) :external-format :utf-8)
                do (vector-push-extend b bytes))))
    (sb-ext:octets-to-string bytes :external-format :utf-8)))

(defun local-file (url)
  (let* ((path (decode-url-path url))
         (parts (uiop:split-string path :separator "/")))
    (when (or (not (uiop:string-prefix-p "/" path))
              (find #\\ path) (find #\Null path)
              (some (lambda (p) (and (plusp (length p)) (char= #\. (char p 0)))) parts))
      (return-from local-file nil))
    (let ((file (merge-pathnames (subseq path 1) *photo-root*)))
      (when (uiop:directory-exists-p file) (setf file (merge-pathnames "index.html" (uiop:ensure-directory-pathname file))))
      (when (and (probe-file file) (not (uiop:directory-pathname-p file))
                 (within-directory-p file *photo-root*)) file))))

(defun mime-type (file)
  (or (cdr (assoc (string-downcase (or (pathname-type file) ""))
    '(("html" . "text/html; charset=utf-8") ("css" . "text/css; charset=utf-8")
      ("js" . "text/javascript; charset=utf-8") ("json" . "application/json; charset=utf-8")
      ("jsonc" . "application/json; charset=utf-8") ("xml" . "application/xml; charset=utf-8")
      ("txt" . "text/plain; charset=utf-8") ("svg" . "image/svg+xml")
      ("jpg" . "image/jpeg") ("jpeg" . "image/jpeg") ("png" . "image/png")
      ("webp" . "image/webp") ("avif" . "image/avif") ("gif" . "image/gif")
      ("ico" . "image/x-icon") ("woff" . "font/woff") ("woff2" . "font/woff2")
      ("mp4" . "video/mp4") ("pdf" . "application/pdf")) :test #'equal))
    "application/octet-stream"))

(defun http-line (stream)
  (with-output-to-string (out)
    (loop for i below 8192 for byte = (read-byte stream nil nil) do
      (unless byte (error "Unexpected HTTP EOF"))
      (when (= byte 10) (return-from http-line (string-right-trim '(#\Return) (get-output-stream-string out))))
      (write-char (code-char byte) out))
    (error "HTTP line too long")))

(defun send-headers (stream status mime size &optional live)
  (write-sequence (sb-ext:string-to-octets
    (with-output-to-string (out)
      (dolist (line (append (list (format nil "HTTP/1.1 ~A" status)
                                 (concatenate 'string "Content-Type: " mime)
                                 (format nil "Content-Length: ~D" size)
                                 "Cache-Control: no-store" "Connection: close")
                           (when live '("X-Photo-Catalog: live")) '("")))
        (format out "~A~C~C" line #\Return #\Newline))) :external-format :utf-8) stream))

(defun handle-photo-request (socket)
  (unwind-protect
    (with-open-stream (stream (sb-bsd-sockets:socket-make-stream socket :input t :output t
                               :element-type '(unsigned-byte 8) :buffering :full :timeout 10))
      (handler-case
        (let* ((request (uiop:split-string (http-line stream) :separator " "))
               (method (first request)) (target (second request))
               (url (and target (subseq target 0 (position #\? target))))
               (head (equal method "HEAD")))
          (loop for i below 100 for line = (http-line stream) until (equal line "")
                finally (unless (equal line "") (error "Too many headers")))
          (cond
            ((not (member method '("GET" "HEAD") :test #'equal))
             (send-headers stream "405 Method Not Allowed" "text/plain" 0))
            ((equal url "/photos/data.json")
             (let ((body (sb-ext:string-to-octets (json-text (photo-catalog)) :external-format :utf-8)))
               (send-headers stream "200 OK" "application/json; charset=utf-8" (length body) t)
               (unless head (write-sequence body stream))))
            (t (let ((file (local-file url)))
                 (if file
                   (with-open-file (input file :element-type '(unsigned-byte 8))
                     (send-headers stream "200 OK" (mime-type file) (file-length input))
                     (unless head
                       (let ((buffer (make-array 65536 :element-type '(unsigned-byte 8))))
                         (loop for count = (read-sequence buffer input) while (plusp count)
                               do (write-sequence buffer stream :end count)))))
                   (send-headers stream "404 Not Found" "text/plain" 0))))))
        (error () (ignore-errors (send-headers stream "400 Bad Request" "text/plain" 0)))))
    (ignore-errors (sb-bsd-sockets:socket-close socket))))

(defun serve-photos (port)
  (unless (<= 1 port 65535) (error "Port must be between 1 and 65535"))
  (let ((server (make-instance 'sb-bsd-sockets:inet-socket :type :stream :protocol :tcp)))
    (unwind-protect
      (progn
        (setf (sb-bsd-sockets:sockopt-reuse-address server) t)
        (sb-bsd-sockets:socket-bind server #(127 0 0 1) port)
        (sb-bsd-sockets:socket-listen server 32)
        (format t "Serving http://localhost:~D/ (live photo catalog)~%" port)
        (force-output)
        (loop (let ((client (sb-bsd-sockets:socket-accept server)))
                (sb-thread:make-thread (lambda () (handle-photo-request client)) :name "local HTTP"))))
      (sb-bsd-sockets:socket-close server))))

(unless (member :photo-catalog-test *features*)
  (let ((args (uiop:command-line-arguments)))
    (cond ((null args) (write-photo-catalog))
          ((and (equal (first args) "--serve") (= (length args) 2))
           (handler-case (serve-photos (parse-integer (second args)))
             (sb-sys:interactive-interrupt () (format t "~%Server stopped.~%"))))
          (t (error "Usage: sbcl --script scripts/photo-catalog.lisp [--serve PORT]")))))
